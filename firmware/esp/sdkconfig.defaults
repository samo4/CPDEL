# Persisted sdkconfig overrides.
# Generated from sdkconfig by selecting non-default values.
# idf.py merges this into a fresh sdkconfig on first build after checkout.

# LVGL fonts
CONFIG_LV_FONT_MONTSERRAT_20=y

# LVGL logging (disabled by default in ESP component, enabled in sim)
CONFIG_LV_USE_LOG=y


# CONFIG_LV_MEM_CUSTOM is not set  # use fixed pool, not system malloc
# LVGL memory pool: 48 KB (was 32 KB default, too small for 9 pre-created screens)
CONFIG_LV_MEM_SIZE_KILOBYTES=36

# FreeRTOS tick rate: 1000 Hz = 1 ms per tick so pdMS_TO_TICKS() has 1 ms resolution
# Without this, the default 100 Hz (10 ms/tick) makes pdMS_TO_TICKS(5)=0 which turns
# vTaskDelay() into a bare yield, starving the IDLE task and triggering the TWDT.
CONFIG_FREERTOS_HZ=1000

# FreeRTOS diagnostics: canary-based stack overflow detection
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# ILI9341 via SPI: use 16-bit RGB565 to match display hardware (sim uses 32-bit SDL)
CONFIG_LV_COLOR_DEPTH_16=y

# Byte-swap each RGB565 pixel so SPI sends the high byte first (ILI9341 is big-endian)
CONFIG_LV_COLOR_16_SWAP=y

# LVGL text formatting: use libc snprintf/vsnprintf and allow float specifiers (%f)
CONFIG_LV_SPRINTF_CUSTOM=y
CONFIG_LV_SPRINTF_USE_FLOAT=y

# Custom partition layout: dual OTA slots plus SPIFFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Board flash size must match hardware
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# HTTP server websocket support for live browser telemetry
CONFIG_HTTPD_WS_SUPPORT=y

# OTA: if new firmware doesn't call esp_ota_mark_app_valid_cancel_rollback(),
# the bootloader automatically rolls back to the previous working image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTPS OTA root CA bundle for esp_crt_bundle_attach()
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# OTA: fetch firmware in independent Range requests so CDN connection-close never aborts mid-download
CONFIG_ESP_HTTPS_OTA_ENABLE_PARTIAL_DOWNLOAD=y

# Reduce TLS RAM footprint for OTA (GitHub Pages download)
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# OTA over HTTPS can block for multiple seconds in TLS/network paths.
# Relax Task WDT defaults to avoid false positives during OTA operations.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# Keep task WDT enabled, but stop monitoring IDLE during OTA-heavy runtime.
# (We still manually feed/reset from OTA task loop.)
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
