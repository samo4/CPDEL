# Persisted sdkconfig overrides.
# Generated from sdkconfig by selecting non-default values.
# idf.py merges this into a fresh sdkconfig on first build after checkout.

# LVGL fonts
CONFIG_LV_FONT_MONTSERRAT_20=y

# LVGL logging (disabled by default in ESP component, enabled in sim)
CONFIG_LV_USE_LOG=y


CONFIG_LV_MEM_CUSTOM=1 
# LVGL memory: default is 32 KB which is too small; use 64 KB
# CONFIG_LV_MEM_SIZE_KILOBYTES=64

# FreeRTOS tick rate: 1000 Hz = 1 ms per tick so pdMS_TO_TICKS() has 1 ms resolution
# Without this, the default 100 Hz (10 ms/tick) makes pdMS_TO_TICKS(5)=0 which turns
# vTaskDelay() into a bare yield, starving the IDLE task and triggering the TWDT.
CONFIG_FREERTOS_HZ=1000

# FreeRTOS diagnostics: canary-based stack overflow detection
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# ILI9341 via SPI: use 16-bit RGB565 to match display hardware (sim uses 32-bit SDL)
CONFIG_LV_COLOR_DEPTH_16=y

# Byte-swap each RGB565 pixel so SPI sends the high byte first (ILI9341 is big-endian)
CONFIG_LV_COLOR_16_SWAP=y

# LVGL text formatting: use libc snprintf/vsnprintf and allow float specifiers (%f)
CONFIG_LV_SPRINTF_CUSTOM=y
CONFIG_LV_SPRINTF_USE_FLOAT=y

# Custom partition layout: dual OTA slots plus SPIFFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Board flash size must match hardware
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
